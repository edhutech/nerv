{
  "name": "@edhutech/nerv",
  "version": "0.2.4",
  "description": "Local-first agent work harness for developers who work with coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/edhutech/nerv.git"
  },
  "bugs": {
    "url": "https://github.com/edhutech/nerv/issues"
  },
  "homepage": "https://github.com/edhutech/nerv#readme",
  "keywords": [
    "cli",
    "coding-agents",
    "developer-workflow",
    "git",
    "local-first"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "nerv": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".agents/skills/nerv/SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:package": "node scripts/package-test.mjs",
    "validate": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.3"
  }
}
